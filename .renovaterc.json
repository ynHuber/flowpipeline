{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "enabled": false,
      "matchPackageNames": [
        "codeberg.org/belwue/flowpipeline"
      ]
    }
  ],
  "semanticCommits": "auto",
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "yhuber"
  ]
}
